# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commit o .env no git. Para gerar SECRET_KEY: python3 -c "import secrets; print(secrets.token_urlsafe(64))"

# DEV LOCAL (macOS com PostgreSQL via Homebrew, auth trust):
#   DATABASE_URL=postgresql://SEU_USUARIO_MAC@localhost:5432/gado_system
# DEV LOCAL (com senha):
#   DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/gado_system
# PRODUCAO (Render/Railway/Heroku):
#   DATABASE_URL e injetada automaticamente pelo provedor; nao precisa configurar aqui.

DATABASE_URL=postgresql://usuario:senha@localhost:5432/gado_system

# Chave para assinar tokens JWT. Gere uma forte e mantenha em segredo.
# Em producao, NUNCA reutilize a mesma chave do dev.
SECRET_KEY=troque-isso-por-uma-chave-gerada-com-secrets-token_urlsafe

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
